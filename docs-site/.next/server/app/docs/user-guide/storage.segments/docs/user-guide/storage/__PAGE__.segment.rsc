 deep_research_engine.storage import StorageManager\n\n# Create manager\nstorage = StorageManager()\n\n# Initialize backends\nawait storage.initialize(\"postgres\", {\n    \"connection\": \"postgresql://localhost:5433/deep_research\",\n    \"vector_index\": \"research\"\n})\n\n# Get backend\nbackend = storage.get_backend(\"postgres\")\n\n# Store data\nresult = await storage.store(data, namespace=\"research\")\n\n# Retrieve data\ndata = await storage.retrieve(result.id, namespace=\"research\")\n\n# Query data\nresults = await storage.query(\"machine learning\", namespace=\"research\", limit=10)\n\n# Cleanup\nawait storage.cleanup()\n"}]}]]}]]}],"\n","$L2","\n","$L3","\n","$L4","\n","$L5","\n","$L6","\n","$L7","\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e","\n","$L2f","\n","$L30","\n","$L31","\n","$L32","\n","$L33","\n","$L34","\n","$L35","\n","$L36","\n","$L37","\n","$L38","\n","$L39","\n","$L3a","\n","$L3b","\n","$L3c","\n","$L3d","\n","$L3e","\n","$L3f","\n","$L40","\n","$L41","\n","$L42","\n","$L43","\n","$L44","\n","$L45","\n","$L46","\n","$L47","\n","$L48"],null,"$L49"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"fGZt_DnWuGacpFmz7jr05"}
