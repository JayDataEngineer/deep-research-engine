{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/docs/layout,_N_T_/docs/internals/layout,_N_T_/docs/internals/page,_N_T_/docs/internals"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/docs/internals/__PAGE__",
    "/docs/internals",
    "/docs",
    "/_index",
    "/_head"
  ]
}