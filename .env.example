# Deep Research Engine - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# LANGFUSE - Prompt Management & Observability
# =============================================================================
# Get your keys from: http://langfuse.local (after running: make up-langfuse)
# REQUIRED - Application will fail without LangFuse

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://langfuse.local

# =============================================================================
# LITELLM - Inference Gateway
# =============================================================================
# LiteLLM provides unified access to all LLM providers

LITELLM_BASE_URL=http://litellm.local/v1
LITELLM_API_KEY=sk-litellm-master

# =============================================================================
# LLM MODELS
# =============================================================================
# Available models via LiteLLM

MAIN_MODEL=qwen-35-27
TOOL_MODEL=qwen-35-27-fast
EMBEDDING_MODEL=jina-v5-embed

# =============================================================================
# STORAGE BACKENDS
# =============================================================================

# PostgreSQL (for vectors and structured data)
CONTEXT_POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/deep_research

# Neo4j (for knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# MongoDB (for media files)
MONGODB_URI=mongodb://localhost:27017

# MinIO/S3 (for object storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# =============================================================================
# EXECUTION SETTINGS
# =============================================================================

# Maximum concurrent workers
MAX_CONCURRENT_WORKERS=10

# Timeout settings (seconds)
WORKFLOW_TIMEOUT=600
WORKER_TIMEOUT=300

# Enable/disable streaming
STREAMING_ENABLED=true

# =============================================================================
# LOGGING
# =============================================================================

# Log level: debug, info, warning, error
LOG_LEVEL=info

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Enable debug mode
DEBUG=false

# Skip SSL verification (development only)
SKIP_SSL_VERIFY=true
